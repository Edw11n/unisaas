# ============================================================================
# UniSaaS - .env.production.example (PLANTILLA, sin secretos reales)
# ============================================================================
# Copie este archivo a la ubicacion que corresponda y reemplace TODOS los
# valores CAMBIA_* por valores reales generados en el servidor.
#
# Este archivo de la RAIZ documenta el contrato completo del sistema:
#   - infraestructura Docker (PostgreSQL/Redis/JWT) usada por squad8
#   - variables compartidas entre squads
#
# PM2 NO lee este archivo. Cada app lee su propio .env (ver
# `env_file` en ecosystem.config.cjs). Copie tambien cada
# `squad*/.env.production.example` al `.env` de su squad.
#
# Reglas:
#   - NUNCA commitear .env reales (ya estan en .gitignore).
#   - NUNCA reutilizar el JWT_SECRET de desarrollo.
#   - Generar secretos: openssl rand -base64 48
#   - La contrasena dentro de DATABASE_URL debe ir URL-encoded si contiene
#     caracteres como @ : / ? # % &
#   - `app.example.com` es un dominio de EJEMPLO. Reemplacelo por el real o
#     ejecute scripts/set-domain.ps1, que actualiza los .env de los squads.
# ============================================================================

# ---------------------------------------------------------------------------
# Entorno
# ---------------------------------------------------------------------------
NODE_ENV=production

# ---------------------------------------------------------------------------
# PostgreSQL (contenedor postgres-saas)
# ---------------------------------------------------------------------------
# Usadas por squad8/docker-compose.yml al crear el contenedor.
POSTGRES_DB=saas_contable_db
POSTGRES_USER=saas_admin
POSTGRES_PASSWORD=CAMBIA_POSTGRES_ADMIN_PASSWORD
POSTGRES_PORT=5432

# Rol de aplicacion (runtime). Sin SUPERUSER, sin BYPASSRLS.
APP_RUNTIME_USER=app_runtime
APP_RUNTIME_PASSWORD=CAMBIA_APP_RUNTIME_PASSWORD

# Rol propietario de DDL/migraciones (bootstrap del contenedor).
MIGRATION_OWNER_PASSWORD=CAMBIA_MIGRATION_OWNER_PASSWORD

# URL que deben usar TODAS las apps (rol de minimo privilegio).
# Equivale a: postgresql://app_runtime:<password>@127.0.0.1:5432/saas_contable_db
DATABASE_URL=postgresql://app_runtime:CAMBIA_APP_RUNTIME_PASSWORD@127.0.0.1:5432/saas_contable_db

# S1 activa TLS por defecto cuando NODE_ENV=production. Para el PostgreSQL
# local en Docker (ssl=off) hay que desactivarlo explicitamente.
DB_SSL=false
# Validacion del certificado TLS (S2). true salvo CA autofirmada controlada.
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SYNCHRONIZE=false

# ---------------------------------------------------------------------------
# Redis (contenedor redis-saas)
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# JWT (compartido por S1, S3, S6, S7 y el BFF)
# ---------------------------------------------------------------------------
# Minimo 32 caracteres; el BFF y S3 abortan el arranque si falta o es corto.
# Rotar este valor invalida todas las sesiones emitidas.
JWT_SECRET=CAMBIA_GENERA_CON_openssl_rand_base64_48

# ---------------------------------------------------------------------------
# Cookies de sesion del BFF
# ---------------------------------------------------------------------------
# COOKIE_SECURE=true exige HTTPS en el navegador. Para operar por HTTP en una
# LAN (por ejemplo http://192.168.1.10:3100) use false. Si se omite, el BFF
# usa NODE_ENV: production => true, cualquier otro => false.
COOKIE_SECURE=true
# lax | strict | none. Use lax salvo que necesite cookies cross-site.
# SameSite=None exige COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax

# ---------------------------------------------------------------------------
# Puertos (fijados tambien en ecosystem.config.cjs)
# ---------------------------------------------------------------------------
S1_PORT=3001
S2_PORT=3002
S3_PORT=3003
S6_PORT=3006
S7_PORT=3007
BFF_PORT=3100

# ---------------------------------------------------------------------------
# URLs internas entre servicios (solo loopback / red privada)
# ---------------------------------------------------------------------------
AUTH_SERVICE_URL=http://127.0.0.1:3001
ACCOUNTING_SERVICE_URL=http://127.0.0.1:3002
INVENTORY_SERVICE_URL=http://127.0.0.1:3003
REPORTS_SERVICE_URL=http://127.0.0.1:3006
CREDITS_SERVICE_URL=http://127.0.0.1:3007

# ---------------------------------------------------------------------------
# BFF / Next.js (valores NEXT_PUBLIC_* se HORNEAN en `next build`)
# ---------------------------------------------------------------------------
# El POS debe operar con datos reales.
NEXT_PUBLIC_USE_MOCKS=false

# URL publica del BFF (misma que ve el navegador).
NEXT_PUBLIC_API_GATEWAY_URL=https://app.example.com
# Alias estable del origen publico. Usado por scripts/set-domain.ps1.
APP_URL=https://app.example.com

# Origen(es) permitidos por CORS en las APIs Nest. Debe incluir el origen
# publico del BFF (esquema + host + puerto, sin barra final).
CORS_ORIGINS=https://app.example.com

# ---------------------------------------------------------------------------
# Proxy inverso / TLS
# ---------------------------------------------------------------------------
# El BFF usa `COOKIE_SECURE` para decidir el atributo Secure de la cookie
# (por defecto true solo si NODE_ENV=production). Para produccion publica
# mantenga COOKIE_SECURE=true y publique por HTTPS. Termine TLS en
# Nginx/Caddy/IIS ARR y reenvie:
#   X-Forwarded-Proto: https
#   X-Forwarded-Host:  app.example.com
#   X-Forwarded-For:   $proxy_add_x_forwarded_for
PUBLIC_HOST=app.example.com
PUBLIC_SCHEME=https
TLS_CERT_PATH=/etc/letsencrypt/live/app.example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/app.example.com/privkey.pem

# ---------------------------------------------------------------------------
# Operacion
# ---------------------------------------------------------------------------
# Destino de backups de scripts/deploy.ps1 y scripts/reset-zero.ps1 (relativo
# a la raiz del repo). Los .dump estan excluidos de Git.
BACKUP_ROOT=backups
TRUST_PROXY=true
