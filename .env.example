# ============================================================================
# UniSaaS Monorepo — .env.example (Plantilla de Desarrollo Local)
# ============================================================================
# Copie este archivo a .env en la raíz o en los paquetes correspondientes.
# NUNCA versione archivos .env reales con credenciales o secretos en Git.
# ============================================================================

# Entorno de Ejecución
NODE_ENV=development
PORT=3000

# Base de Datos PostgreSQL 16 (Multi-Tenant RLS)
DATABASE_URL=postgresql://saas_migration_admin:postgres@localhost:5432/saas_contable_db?schema=public&connection_limit=50&pool_timeout=30

# Redis 7 (Caché, Sesiones O(M) y Rate-Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Autenticación y Tokens JWT
JWT_SECRET=unisaas-super-secret-jwt-key-for-dev-only-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Web POS (Next.js 15)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Dispositivo Móvil Flutter (Opcional)
FLUTTER_API_BASE_URL=http://10.0.2.2:3000/api/v1

