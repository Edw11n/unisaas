// ============================================================================
// DOMINIO DE INVENTARIO, CATÁLOGO, BODEGAS Y KARDEX CPP
// ============================================================================

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("product_status_enum")
}

enum ProductType {
  STOCKABLE
  SERVICE

  @@map("product_type_enum")
}

enum ProductVariantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("variant_status_enum")
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("warehouse_status_enum")
}

enum MovementType {
  PURCHASE_RECEIPT
  SALE_DISPATCH
  TRANSFER_IN
  TRANSFER_OUT
  SHRINKAGE_LOSS
  DAMAGE_LOSS
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  VOID_RETURN

  @@map("movement_type_enum")
}

enum MovementStatus {
  DRAFT
  POSTED
  REVERSED

  @@map("movement_status_enum")
}

enum MovementSource {
  POS
  PURCHASE
  TRANSFER
  ADJUSTMENT
  STOCK_COUNT
  RETURN
  SYSTEM

  @@map("movement_source_enum")
}

enum ReferenceType {
  POS_SALE
  POS_VOID
  PURCHASE
  PURCHASE_RETURN
  TRANSFER
  STOCK_COUNT
  MANUAL_ADJUSTMENT
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  OTHER

  @@map("reference_type_enum")
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
  REVERSED

  @@map("transfer_status_enum")
}

enum BarcodeType {
  EAN13
  EAN8
  UPC
  CODE128
  INTERNAL
  OTHER

  @@map("barcode_type_enum")
}

enum CostMethod {
  WEIGHTED_AVERAGE

  @@map("cost_method_enum")
}

enum AdjustmentReason {
  INITIAL_STOCK
  STOCK_COUNT
  DAMAGE
  LOSS
  FOUND
  CORRECTION
  OTHER

  @@map("adjustment_reason_enum")
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("stock_count_status_enum")
}

enum StockCountLineStatus {
  PENDING
  COUNTED
  APPLIED
  CANCELLED

  @@map("stock_count_line_status_enum")
}

enum UnitType {
  UNIT
  LENGTH
  WEIGHT
  VOLUME
  PACKAGE
  OTHER

  @@map("unit_type_enum")
}

model ProductCategory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  parentId    String?  @map("parent_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, name], map: "uq_tenant_category_name")
  @@unique([tenantId, id], map: "uq_product_categories_tenant_id")
  @@index([tenantId, parentId], map: "idx_category_tenant_parent")
  @@map("product_categories")
}

model UnitOfMeasure {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  code             String   @db.VarChar(20)
  name             String   @db.VarChar(50)
  symbol           String   @db.VarChar(10)
  unitType         UnitType @map("unit_type")
  decimalPlaces    Int      @default(3) @map("decimal_places")
  conversionFactor Decimal  @default(1.000000) @map("conversion_factor") @db.Decimal(18, 6)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products      Product[]
  variants      ProductVariant[]
  movementLines InventoryMovementLine[]

  @@unique([tenantId, code], map: "uq_tenant_uom_code")
  @@unique([tenantId, id], map: "uq_unit_of_measures_tenant_id")
  @@index([tenantId, unitType], map: "idx_uom_tenant_type")
  @@map("unit_of_measures")
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  sku             String        @db.VarChar(50)
  name            String        @db.VarChar(150)
  description     String?       @db.Text
  barcode         String?       @db.VarChar(50)
  categoryId      String?       @map("category_id") @db.Uuid
  productType     ProductType   @default(STOCKABLE) @map("product_type")
  status          ProductStatus @default(ACTIVE)
  costPrice       Decimal       @default(0.000000) @map("cost_price") @db.Decimal(18, 6)
  salePrice       Decimal       @default(0.00) @map("sale_price") @db.Decimal(15, 2)
  wholesalePrice  Decimal?      @map("wholesale_price") @db.Decimal(15, 2)
  taxRate         Decimal       @default(0.19) @map("tax_rate") @db.Decimal(5, 2)
  minStockAlert   Decimal       @default(5.000000) @map("min_stock_alert") @db.Decimal(18, 6)
  unitOfMeasureId String        @map("unit_of_measure_id") @db.Uuid
  costMethod      CostMethod    @default(WEIGHTED_AVERAGE) @map("cost_method")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt      DateTime?     @map("archived_at") @db.Timestamptz

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category          ProductCategory?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unitOfMeasure     UnitOfMeasure           @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)
  variants          ProductVariant[]
  barcodes          ProductBarcode[]
  inventoryBalances InventoryBalance[]
  movementLines     InventoryMovementLine[]
  ledgerEntries     InventoryLedgerEntry[]
  transferLines     InventoryTransferLine[]
  stockCountLines   StockCountLine[]
  invoiceItems      InvoiceItem[]
  purchaseItems     PurchaseItem[]

  @@unique([tenantId, sku], map: "uq_tenant_product_sku")
  @@unique([tenantId, id], map: "uq_products_tenant_id")
  @@index([tenantId, barcode], map: "idx_products_tenant_barcode")
  @@index([tenantId, categoryId], map: "idx_products_tenant_category")
  @@map("products")
}

model ProductVariant {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  productId       String               @map("product_id") @db.Uuid
  sku             String               @db.VarChar(50)
  name            String               @db.VarChar(150)
  description     String?              @db.Text
  status          ProductVariantStatus @default(ACTIVE)
  costPrice       Decimal              @default(0.000000) @map("cost_price") @db.Decimal(18, 6)
  salePrice       Decimal              @default(0.00) @map("sale_price") @db.Decimal(15, 2)
  wholesalePrice  Decimal?             @map("wholesale_price") @db.Decimal(15, 2)
  taxRate         Decimal              @default(0.19) @map("tax_rate") @db.Decimal(5, 2)
  minStockAlert   Decimal              @default(5.000000) @map("min_stock_alert") @db.Decimal(18, 6)
  unitOfMeasureId String               @map("unit_of_measure_id") @db.Uuid
  isDefault       Boolean              @default(false) @map("is_default")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt      DateTime?            @map("archived_at") @db.Timestamptz

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product           Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitOfMeasure     UnitOfMeasure           @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)
  barcodes          ProductBarcode[]
  inventoryBalances InventoryBalance[]
  movementLines     InventoryMovementLine[]
  ledgerEntries     InventoryLedgerEntry[]
  transferLines     InventoryTransferLine[]
  stockCountLines   StockCountLine[]
  invoiceItems      InvoiceItem[]
  purchaseItems     PurchaseItem[]

  @@unique([tenantId, sku], map: "uq_tenant_variant_sku")
  @@unique([tenantId, id], map: "uq_product_variants_tenant_id")
  @@index([tenantId, productId], map: "idx_variants_tenant_product")
  @@map("product_variants")
}

model ProductBarcode {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  barcode   String      @db.VarChar(50)
  type      BarcodeType @default(INTERNAL)
  productId String?     @map("product_id") @db.Uuid
  variantId String?     @map("variant_id") @db.Uuid
  isPrimary Boolean     @default(false) @map("is_primary")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, barcode], map: "uq_tenant_barcode")
  @@unique([tenantId, id], map: "uq_product_barcodes_tenant_id")
  @@index([tenantId, productId], map: "idx_barcodes_tenant_product")
  @@index([tenantId, variantId], map: "idx_barcodes_tenant_variant")
  @@map("product_barcodes")
}

model Warehouse {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  branchId    String          @map("branch_id") @db.Uuid
  code        String          @db.VarChar(20)
  name        String          @db.VarChar(100)
  description String?         @db.Text
  status      WarehouseStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt  DateTime?       @map("archived_at") @db.Timestamptz

  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch               Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  inventoryBalances    InventoryBalance[]
  sourceTransfers      InventoryTransfer[]    @relation("TransferSourceWarehouse")
  destinationTransfers InventoryTransfer[]    @relation("TransferDestinationWarehouse")
  movements            InventoryMovement[]
  ledgerEntries        InventoryLedgerEntry[]
  stockCounts          StockCount[]
  purchases            Purchase[]

  @@unique([tenantId, code], map: "uq_tenant_warehouse_code")
  @@unique([tenantId, id], map: "uq_warehouses_tenant_id")
  @@index([tenantId, branchId], map: "idx_warehouses_tenant_branch")
  @@map("warehouses")
}

model InventoryBalance {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  warehouseId      String   @map("warehouse_id") @db.Uuid
  quantityOnHand   Decimal  @default(0.000000) @map("quantity_on_hand") @db.Decimal(18, 6)
  reservedQuantity Decimal  @default(0.000000) @map("reserved_quantity") @db.Decimal(18, 6)
  averageCost      Decimal  @default(0.000000) @map("average_cost") @db.Decimal(18, 6)
  inventoryValue   Decimal  @default(0.0000) @map("inventory_value") @db.Decimal(20, 4)
  version          BigInt   @default(0)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([tenantId, variantId, warehouseId], map: "uq_tenant_variant_warehouse")
  @@unique([tenantId, id], map: "uq_inventory_balances_tenant_id")
  @@index([tenantId, warehouseId], map: "idx_balances_warehouse")
  @@index([tenantId, productId], map: "idx_balances_product")
  @@map("inventory_balances")
}

model InventoryTransfer {
  id                     String         @id @default(uuid()) @db.Uuid
  tenantId               String         @map("tenant_id") @db.Uuid
  sourceWarehouseId      String         @map("source_warehouse_id") @db.Uuid
  destinationWarehouseId String         @map("destination_warehouse_id") @db.Uuid
  status                 TransferStatus @default(DRAFT)
  referenceDocument      String?        @map("reference_document") @db.VarChar(100)
  notes                  String?        @db.Text
  outboundMovementId     String?        @unique @map("outbound_movement_id") @db.Uuid
  inboundMovementId      String?        @unique @map("inbound_movement_id") @db.Uuid
  createdById            String?        @map("created_by_id") @db.Uuid
  completedById          String?        @map("completed_by_id") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  shippedAt              DateTime?      @map("shipped_at") @db.Timestamptz
  receivedAt             DateTime?      @map("received_at") @db.Timestamptz

  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceWarehouse      Warehouse               @relation("TransferSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse Warehouse               @relation("TransferDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  outboundMovement     InventoryMovement?      @relation("TransferOutboundMovement", fields: [outboundMovementId], references: [id], onDelete: Restrict)
  inboundMovement      InventoryMovement?      @relation("TransferInboundMovement", fields: [inboundMovementId], references: [id], onDelete: Restrict)
  createdBy            User?                   @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy          User?                   @relation("TransferCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  lines                InventoryTransferLine[]

  @@unique([tenantId, id], map: "uq_inventory_transfers_tenant_id")
  @@index([tenantId, sourceWarehouseId], map: "idx_transfers_source")
  @@index([tenantId, destinationWarehouseId], map: "idx_transfers_destination")
  @@map("inventory_transfers")
}

model InventoryTransferLine {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  transferId        String   @map("transfer_id") @db.Uuid
  lineNumber        Int      @map("line_number")
  productId         String   @map("product_id") @db.Uuid
  variantId         String   @map("variant_id") @db.Uuid
  quantity          Decimal  @db.Decimal(18, 6)
  transferUnitCost  Decimal  @map("transfer_unit_cost") @db.Decimal(18, 6)
  transferTotalCost Decimal  @map("transfer_total_cost") @db.Decimal(20, 4)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([transferId, lineNumber], map: "uq_transfer_line_number")
  @@unique([tenantId, id], map: "uq_transfer_lines_tenant_id")
  @@map("inventory_transfer_lines")
}

model StockCount {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  warehouseId       String           @map("warehouse_id") @db.Uuid
  status            StockCountStatus @default(DRAFT)
  referenceDocument String?          @map("reference_document") @db.VarChar(100)
  notes             String?          @db.Text
  createdById       String?          @map("created_by_id") @db.Uuid
  completedById     String?          @map("completed_by_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  startedAt         DateTime?        @map("started_at") @db.Timestamptz
  completedAt       DateTime?        @map("completed_at") @db.Timestamptz

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy   User?            @relation("StockCountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy User?            @relation("StockCountCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  lines       StockCountLine[]

  @@unique([tenantId, id], map: "uq_stock_counts_tenant_id")
  @@index([tenantId, warehouseId], map: "idx_stock_counts_warehouse")
  @@map("stock_counts")
}

model StockCountLine {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  stockCountId       String               @map("stock_count_id") @db.Uuid
  productId          String               @map("product_id") @db.Uuid
  variantId          String               @map("variant_id") @db.Uuid
  systemQuantity     Decimal              @map("system_quantity") @db.Decimal(18, 6)
  countedQuantity    Decimal?             @map("counted_quantity") @db.Decimal(18, 6)
  differenceQuantity Decimal?             @map("difference_quantity") @db.Decimal(18, 6)
  status             StockCountLineStatus @default(PENDING)
  countedById        String?              @map("counted_by_id") @db.Uuid
  countedAt          DateTime?            @map("counted_at") @db.Timestamptz
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockCount StockCount     @relation(fields: [stockCountId], references: [id], onDelete: Restrict)
  product    Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  countedBy  User?          @relation("StockCountLineCountedBy", fields: [countedById], references: [id], onDelete: SetNull)

  @@unique([stockCountId, variantId], map: "uq_stock_count_variant")
  @@unique([tenantId, id], map: "uq_stock_count_lines_tenant_id")
  @@map("stock_count_lines")
}

model InventoryMovement {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  type               MovementType
  status             MovementStatus    @default(DRAFT)
  source             MovementSource
  warehouseId        String            @map("warehouse_id") @db.Uuid
  referenceType      ReferenceType?    @map("reference_type")
  referenceId        String?           @map("reference_id") @db.Uuid
  referenceDocument  String?           @map("reference_document") @db.VarChar(100)
  reason             String?           @db.Text
  adjustmentReason   AdjustmentReason? @map("adjustment_reason")
  createdById        String?           @map("created_by_id") @db.Uuid
  postedById         String?           @map("posted_by_id") @db.Uuid
  reversedById       String?           @map("reversed_by_id") @db.Uuid
  reversesMovementId String?           @unique @map("reverses_movement_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  postedAt           DateTime?         @map("posted_at") @db.Timestamptz
  reversedAt         DateTime?         @map("reversed_at") @db.Timestamptz

  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse        Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy        User?                   @relation("MovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  postedBy         User?                   @relation("MovementPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  reversedBy       User?                   @relation("MovementReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)
  reversesMovement InventoryMovement?      @relation("MovementReversal", fields: [reversesMovementId], references: [id], onDelete: Restrict)
  reversalOf       InventoryMovement?      @relation("MovementReversal")
  outboundTransfer InventoryTransfer?      @relation("TransferOutboundMovement")
  inboundTransfer  InventoryTransfer?      @relation("TransferInboundMovement")
  lines            InventoryMovementLine[]
  ledgerEntries    InventoryLedgerEntry[]
  auditLogs        InventoryAuditLog[]

  @@unique([tenantId, id], map: "uq_inventory_movements_tenant_id")
  @@index([tenantId, warehouseId, createdAt], map: "idx_movements_tenant_wh_date")
  @@index([tenantId, referenceType, referenceId], map: "idx_movements_reference")
  @@map("inventory_movements")
}

model InventoryMovementLine {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  movementId           String   @map("movement_id") @db.Uuid
  lineNumber           Int      @map("line_number")
  productId            String   @map("product_id") @db.Uuid
  variantId            String   @map("variant_id") @db.Uuid
  unitOfMeasureId      String   @map("unit_of_measure_id") @db.Uuid
  quantity             Decimal  @db.Decimal(18, 6)
  unitCost             Decimal  @map("unit_cost") @db.Decimal(18, 6)
  totalCost            Decimal  @map("total_cost") @db.Decimal(20, 4)
  previousQuantity     Decimal  @map("previous_quantity") @db.Decimal(18, 6)
  newQuantity          Decimal  @map("new_quantity") @db.Decimal(18, 6)
  averageCostBefore    Decimal  @map("average_cost_before") @db.Decimal(18, 6)
  averageCostAfter     Decimal  @map("average_cost_after") @db.Decimal(18, 6)
  inventoryValueBefore Decimal  @map("inventory_value_before") @db.Decimal(20, 4)
  inventoryValueAfter  Decimal  @map("inventory_value_after") @db.Decimal(20, 4)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movement      InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  unitOfMeasure UnitOfMeasure     @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)

  @@unique([movementId, lineNumber], map: "uq_movement_line_number")
  @@unique([tenantId, id], map: "uq_movement_lines_tenant_id")
  @@index([tenantId, productId, createdAt], map: "idx_movement_lines_product")
  @@map("inventory_movement_lines")
}

model InventoryLedgerEntry {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  sequence             BigInt         @unique @default(autoincrement())
  movementId           String         @map("movement_id") @db.Uuid
  productId            String         @map("product_id") @db.Uuid
  variantId            String         @map("variant_id") @db.Uuid
  warehouseId          String         @map("warehouse_id") @db.Uuid
  movementType         MovementType   @map("movement_type")
  referenceType        ReferenceType? @map("reference_type")
  referenceId          String?        @map("reference_id") @db.Uuid
  quantityIn           Decimal        @default(0.000000) @map("quantity_in") @db.Decimal(18, 6)
  unitCostIn           Decimal        @default(0.000000) @map("unit_cost_in") @db.Decimal(18, 6)
  totalCostIn          Decimal        @default(0.0000) @map("total_cost_in") @db.Decimal(20, 4)
  quantityOut          Decimal        @default(0.000000) @map("quantity_out") @db.Decimal(18, 6)
  unitCostOut          Decimal        @default(0.000000) @map("unit_cost_out") @db.Decimal(18, 6)
  totalCostOut         Decimal        @default(0.0000) @map("total_cost_out") @db.Decimal(20, 4)
  balanceQuantityAfter Decimal        @map("balance_quantity_after") @db.Decimal(18, 6)
  averageCostAfter     Decimal        @map("average_cost_after") @db.Decimal(18, 6)
  inventoryValueAfter  Decimal        @map("inventory_value_after") @db.Decimal(20, 4)
  occurredAt           DateTime       @default(now()) @map("occurred_at") @db.Timestamptz

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movement  InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id], map: "uq_inventory_ledger_tenant_id")
  @@index([tenantId, variantId, warehouseId, occurredAt], map: "idx_ledger_kardex_timeline")
  @@index([tenantId, productId, occurredAt], map: "idx_ledger_product_timeline")
  @@map("inventory_ledger_entries")
}

model InventoryAuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  action        AuditAction
  entityType    String      @map("entity_type") @db.VarChar(100)
  entityId      String      @map("entity_id") @db.Uuid
  movementId    String?     @map("movement_id") @db.Uuid
  performedById String?     @map("performed_by_id") @db.Uuid
  oldValues     Json?       @map("old_values") @db.JsonB
  newValues     Json?       @map("new_values") @db.JsonB
  reason        String?     @db.Text
  ipAddress     String?     @map("ip_address") @db.VarChar(64)
  userAgent     String?     @map("user_agent") @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movement    InventoryMovement? @relation(fields: [movementId], references: [id], onDelete: Restrict)
  performedBy User?              @relation("InventoryAuditLogPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, id], map: "uq_inventory_audit_tenant_id")
  @@index([tenantId, entityType, entityId], map: "idx_inv_audit_entity")
  @@map("inventory_audit_logs")
}

